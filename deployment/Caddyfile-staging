# See https://caddyserver.com/docs

# TODO: разобраться как написать корректный матчер для cors
# условие - что есть header Origin из разрешенного списка
# и отдавать надо конкретному Origin конкретные Access-Control-Allow-Origin
(cors) {
	@cors_preflight {
		method OPTIONS
		header Origin {args.0}
	}
	@cors header Origin {args.0}

	handle @cors_preflight {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE"
		header Access-Control-Allow-Headers "Authorization,Content-Type"
		header Access-Control-Max-Age "3600"
		header Vary Origin
		header Vary Referer
		header Vary x-origin
		respond "" 204
	}

	handle @cors {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Expose-Headers "Link"
		header Vary Origin
		header Vary Referer
		header Vary x-origin
	}
}

(cors2) {
	@cors_preflight_2 {
		method OPTIONS
		header Origin {args.0}
	}
	@cors_2 header Origin {args.0}

	handle @cors_preflight_2 {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE"
		header Access-Control-Allow-Headers "Authorization,Content-Type"
		header Access-Control-Max-Age "3600"
		header Vary Origin
		header Vary Referer
		header Vary x-origin
		respond "" 204
	}

	handle @cors_2 {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Expose-Headers "Link"
		header Vary Origin
		header Vary Referer
		header Vary x-origin
	}
}

