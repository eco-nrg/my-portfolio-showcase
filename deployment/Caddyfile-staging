{$WEB_APP_ADDRESS} {
	handle /sw.js {
		respond "" 404
	}

	handle {
		header /no-cache* >Cache-Control nocache
		reverse_proxy {
			to webapp:3000
			header_up Host {upstream_hostport}
			header_up X-Forwarded-For {host}
		}
	}

	encode gzip

	log {
		output stdout
	}
}

{$API_ADDRESS} {
	# HTTPS options:
	header Strict-Transport-Security max-age=31536000;

	# Removing some headers for improved security:
	header -Server

	handle_path /static/* {
		root * /var/www/django/static
		file_server
	}

	handle_path /media/* {
		root * /var/www/django/media
		file_server
	}

	handle {
		import cors {$WEB_APP_CORS}
		import cors2 {$DEBUG_CORS}
		reverse_proxy api:8000
	}

	encode gzip

	log {
		output stdout
	}
}

{$DOZZLE_ADDRESS} {
	handle {
		reverse_proxy dozzle:8080
	}

	encode gzip

	log {
		output stdout
	}
}

{$FAKE_PI_ADDRESS} {
	handle {
		reverse_proxy pi:8080
	}

	encode gzip

	log {
		output stdout
	}
}
